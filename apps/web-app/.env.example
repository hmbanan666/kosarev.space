NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kosarev_space
NUXT_PUBLIC_METRIKA_ID=

# Optional, server-only: read-only token for public GitHub activity.
NUXT_GITHUB_TOKEN=

# Optional, server-only. Without a key the site agent returns an offline state.
NUXT_OPENROUTER_API_KEY=
NUXT_AGENT_MODEL=google/gemini-2.5-flash-lite
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
NUXT_AGENT_TRUST_PROXY=false
