{
  "name": "@kosarev/space-monorepo",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.21.0",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:full": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e && pnpm run build",
    "release": "bumpp -r",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@playwright/test": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "bumpp": "catalog:dev",
    "eslint": "catalog:dev",
    "husky": "catalog:dev",
    "nano-staged": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:dev"
  },
  "nano-staged": {
    "*.{js,ts,tsx,vue,json}": [
      "eslint --cache --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
